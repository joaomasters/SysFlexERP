# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env

# Senha do banco de dados (troque por uma senha forte em produção!)
DB_PASSWORD=acougue@2025

# Origens permitidas pelo CORS (URL do seu domínio ou IP)
CORS_ORIGINS=http://localhost,https://seu-dominio.com.br

# Chave que criptografa as credenciais das maquininhas (Stone, Mercado Pago...)
# salvas pela tela Administração → Maquininhas. Gere com: openssl rand -base64 32
# NÃO troque depois de cadastrar credenciais. Guia completo: docs/MAQUININHAS.md
PAGAMENTO_CRIPTO_CHAVE=

# Opcional: token Mercado Pago "global" para o PIX, usado só por empresas que
# não cadastraram o próprio Access Token na tela de Maquininhas.
MP_ACCESS_TOKEN=

# OBRIGATÓRIA: segredo que assina os tokens de login (sem ela o backend não sobe).
# Gere com: openssl rand -base64 48 — nunca commite o valor real.
JWT_SECRET=
